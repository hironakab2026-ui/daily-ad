DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=life_manager
PORT=3100
# ハブ（APP-1）の .env の SESSION_SECRET と必ず同じ値にすること。
# 端末識別Cookie（device_id）の署名をハブと共有し、同じ端末として認識させるため。
SESSION_SECRET=change-this-to-a-random-string
# ハブの当日サマリーカードから「運動管理アプリを開く」で戻ってくる先（任意）
PUBLIC_APP_URL=http://localhost:3100
